# Copie este arquivo para .env e ajuste os valores localmente.
# .env nunca deve ser versionado (ver .gitignore).

# --- PostgreSQL (profile: core) ---
POSTGRES_DB=java_engineering_lab
POSTGRES_USER=jel
POSTGRES_PASSWORD=troque-esta-senha-localmente
PORTA_POSTGRES=5432

# --- Backend (profile: core) ---
PORTA_BACKEND=8080

# --- Frontend (profile: core) ---
PORTA_FRONTEND=3000
# URL que o frontend usa (do lado do servidor) para chamar o backend.
# No docker-compose isso é sobrescrito para http://backend:8080 (rede interna).
BACKEND_API_URL=http://localhost:8080

# --- Kafka (profile: messaging) ---
PORTA_KAFKA=9092
PORTA_KAFKA_UI=8081

# --- Observabilidade (profile: observability) ---
PORTA_PROMETHEUS=9090
PORTA_GRAFANA=3300
PORTA_TEMPO=3200
GRAFANA_USUARIO_ADMIN=admin
GRAFANA_SENHA_ADMIN=troque-esta-senha-localmente

# --- SonarQube (profile: quality) ---
PORTA_SONARQUBE=9000
